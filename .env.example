# OpenSecurityBot / VAPT-Agent Environment Configuration
# Export these in your shell. A .env in the current directory is loaded only when
# VAPT_LOAD_DOTENV=1 is exported (a .env can redirect where findings are sent).

# LLM API configuration
VAPT_LLM_BASE_URL=https://api.openai.com/v1
VAPT_LLM_MODEL=gpt-4o-mini
VAPT_LLM_API_KEY=sk-...

# Operational parameters
# VAPT_LLM_TIMEOUT_MS=60000
# VAPT_LLM_TEMPERATURE=0.2
# VAPT_CONFIG_DIR=~/.config/vapt
# VAPT_NVD_API_KEY=your-nvd-key
# VAPT_NVD_MAX=25
