# OpenSecurityBot / VAPT-Agent Environment Configuration
# Can be used instead of or alongside ~/.config/vapt/config.json

# LLM API configuration
VAPT_LLM_BASE=https://api.openai.com/v1
VAPT_LLM_MODEL=gpt-4o-mini
VAPT_LLM_KEY=sk-...

# Operational parameters
# VAPT_LLM_TIMEOUT_MS=60000
# VAPT_LLM_STREAM_TIMEOUT_MS=120000
# VAPT_LLM_TEMPERATURE=0.2
# VAPT_CONFIG_DIR=~/.config/vapt
